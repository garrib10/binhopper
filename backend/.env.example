# Copy to backend/.env and adjust. Matches docker-compose.yml.
DATABASE_URL=mysql+pymysql://binhopper:binhopper@127.0.0.1:3306/binhopper
# Local dev only; deployed requests are same-origin through the Vercel /api proxy.
CORS_ORIGINS=["http://localhost:5173"]
# Who may set X-Forwarded-For/-Proto ("*" = any peer, as behind Railway's edge).
FORWARDED_ALLOW_IPS=*
# Deployed only: must match Vercel's ORIGIN_SECRET (#122). Empty locally = no check.
# During a rotation accept both: ORIGIN_SECRET=new,old
ORIGIN_SECRET=

# Server/worker only. Never expose this token in VITE_ variables.
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=Binhopper/0.1 (catalog-gap-worker; github.com/garrib10/binhopper)
# Optional: verified artist IDs mapped to their official shop's HTTPS URL.
ARTIST_STORE_URLS={}

# Sign-in (#38). The app's own address: email links, Google's redirect URI, allowed Origin.
PUBLIC_APP_URL=http://localhost:5173
# log = print emails (and their links) in the uvicorn output; resend = send for real.
EMAIL_BACKEND=log
EMAIL_FROM=Binhopper <onboarding@resend.dev>
RESEND_API_KEY=
# Optional locally: Google Cloud OAuth client (see docs/DEPLOY.md › Sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discogs import (#44): an app from discogs.com/settings/developers (callback
# <PUBLIC_APP_URL>/api/discogs/callback) and a Fernet key that encrypts users' tokens.
# Same values on the API and the worker. See docs/DEPLOY.md › Discogs import.
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
TOKEN_ENCRYPTION_KEY=
