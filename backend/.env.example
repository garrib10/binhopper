# Copy to backend/.env and adjust. Matches docker-compose.yml.
DATABASE_URL=mysql+pymysql://binhopper:binhopper@127.0.0.1:3306/binhopper
# Local dev only; deployed requests are same-origin through the Vercel /api proxy.
CORS_ORIGINS=["http://localhost:5173"]
# Who may set X-Forwarded-For/-Proto ("*" = any peer, as behind Railway's edge).
FORWARDED_ALLOW_IPS=*

# Server/worker only. Never expose this token in VITE_ variables.
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=Binhopper/0.1 (catalog-gap-worker; github.com/garrib10/binhopper)
# Optional: verified artist IDs mapped to their official shop's HTTPS URL.
ARTIST_STORE_URLS={}
