# The app always calls same-origin /api: Vite proxies it locally and Vercel
# Routing Middleware (proxy.ts, API_ORIGIN) proxies it when deployed.
# Never put secrets in VITE_ variables: these are included in browser bundles.

# Required for hosted maps; local npm run dev defaults to OSM tiles.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
